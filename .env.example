# Optional. Public Spotify links work through spotDL's credential-free client.
# Set both values to use Spotify's official Web API instead.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Keep localhost-only unless you understand the security implications.
APP_BIND_ADDRESS=127.0.0.1
WEB_PORT=3000

# Structured log verbosity: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

